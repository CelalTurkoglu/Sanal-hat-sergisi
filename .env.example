# Database (Railway will provide this)
DATABASE_URL=

# Admin Credentials (CHANGE THESE IN PRODUCTION!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_in_production

# Session Secret (use a strong random string, min 32 chars)
SESSION_SECRET=

# Application URL (Railway will provide domain)
NEXT_PUBLIC_APP_URL=

# Cloudflare R2 Storage (Optional - falls back to local storage if not set)
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=calligraphy-assets
R2_PUBLIC_URL=https://r2.yourdomain.com

# Image Upload
MAX_FILE_SIZE=10485760
